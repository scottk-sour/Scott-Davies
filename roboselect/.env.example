# ============================================
# DATABASE
# ============================================
DATABASE_URL="postgresql://user:password@localhost:5432/roboselect"

# ============================================
# APP CONFIGURATION
# ============================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="RoboSelect"
NODE_ENV="development"

# ============================================
# ANTHROPIC CLAUDE AI
# ============================================
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY="sk-ant-api03-..."

# ============================================
# EMAIL (RESEND)
# ============================================
# Get your API key from: https://resend.com/
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="quotes@roboselect.co.uk"
RESEND_FROM_NAME="RoboSelect"

# ============================================
# ADMIN AUTHENTICATION
# ============================================
# Generate a random secret: openssl rand -base64 32
ADMIN_JWT_SECRET="your-secret-key-here-min-32-characters"
SESSION_COOKIE_NAME="roboselect-admin-session"
SESSION_COOKIE_MAX_AGE="604800" # 7 days in seconds

# ============================================
# FILE UPLOAD (OPTIONAL)
# ============================================
# Vercel Blob Storage for robot images, PDFs, etc.
# BLOB_READ_WRITE_TOKEN="vercel_blob_..."

# ============================================
# ANALYTICS (OPTIONAL)
# ============================================
# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-..."

# PostHog (product analytics)
# NEXT_PUBLIC_POSTHOG_KEY="phc_..."
# NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# ============================================
# GOOGLE MAPS (OPTIONAL)
# ============================================
# For demo address validation and mapping
# GOOGLE_MAPS_API_KEY="..."

# ============================================
# STRIPE (FUTURE - FOR PAYMENT PROCESSING)
# ============================================
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_PUBLISHABLE_KEY="pk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# ============================================
# FEATURE FLAGS
# ============================================
NEXT_PUBLIC_ENABLE_DEMO_BOOKING="true"
NEXT_PUBLIC_ENABLE_QUOTE_REQUEST="true"
NEXT_PUBLIC_ENABLE_CASE_STUDIES="true"
